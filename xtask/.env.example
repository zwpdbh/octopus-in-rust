# xtask deploy configuration — template.
# Copy to `xtask/.env` and fill in real values. `.env` is git-ignored.
#
# Used by: cargo xtask fafcn deploy-majiko
# Runbook: docs/deploy_fafcn/howto_deploy_to_majiko.md

# REQUIRED — SSH password for the majiko server (also used for sudo -S).
# Quote-safe: any characters except a single quote are fine.
MAJIKO_SSH_PASSWORD=<ssh-password>

# OPTIONAL overrides (defaults shown):
# MAJIKO_SSH_USER=majiko
# MAJIKO_SSH_HOST=8v.pub
# MAJIKO_SSH_PORT=10040
# MAJIKO_DEPLOY_DIR=/opt/fafcn
# MAJIKO_PUBLIC_URL=http://8v.pub:10041
