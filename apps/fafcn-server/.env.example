# Copy this file to `.env` and fill in the values for the LLM backend you want to use.
# `.env` is ignored by git and loaded automatically on startup.
#
# Verify the setup after starting the server with:
#   curl http://localhost:3000/api/health/qa

# HTTP server port (default: 3000)
FAFCN_PORT=3000

# Logging level for the server (default: info). Use "debug" for more detail, or a
# selective filter like the one below to keep dependency crates quiet.
# RUST_LOG=info,fafcn_server=debug,agent_core=debug,llm_provider=debug,reqwest=warn,hyper=warn,hyper_util=warn,rustls=warn,extism=warn,wasmtime=warn

# Built Dioxus web assets. The default assumes a release build of fafcn-web.
# FAFCN_WEB_DIST=target/dx/fafcn-web/release/web/public

# Unit portrait images.
# FAFCN_PORTRAITS_DIR=assets/icons/units

# --- Q&A agent configuration ---

# Provider type:
#   - "openai_compatible" — any OpenAI-compatible API (OpenAI, Moonshot, etc.)
#   - "kimi_code"         — Kimi Code subscription quota (OAuth token file)
FAFCN_LLM_PROVIDER_TYPE=openai_compatible

# Model name.
# Examples:
#   - OpenAI:              gpt-4o
#   - Kimi Code:           kimi-for-coding
#   - Moonshot (CN):       moonshot-v1-8k
FAFCN_LLM_MODEL=gpt-4o

# Base URL of the LLM API.
# Examples:
#   - OpenAI:              https://api.openai.com/v1
#   - Kimi Code:           https://api.kimi.com/coding/v1
#   - Moonshot (CN):       https://api.moonshot.cn/v1
FAFCN_LLM_BASE_URL=https://api.openai.com/v1

# --- Option A: standard OpenAI-compatible provider ---
# Set this when FAFCN_LLM_PROVIDER_TYPE=openai_compatible.
FAFCN_LLM_API_KEY=sk-your-api-key-here

# --- Option B: Kimi Code (subscription quota) ---
# FAFCN_LLM_PROVIDER_TYPE=kimi_code
# FAFCN_LLM_MODEL=kimi-for-coding
# FAFCN_LLM_BASE_URL=https://api.kimi.com/coding/v1
# Path to the OAuth token file created by `kimi login`.
FAFCN_LLM_TOKEN_FILE=/home/YOUR_USERNAME/.kimi/credentials/kimi-code.json

# Directory containing `.wasm` plugins.
# FAFCN_PLUGINS_DIR=data/qqbot-data/plugins

# Optional system prompt override.
# FAFCN_QA_SYSTEM_PROMPT=You are an expert assistant for the game Forged Alliance Forever.

# Maximum agent reasoning steps per turn.
# FAFCN_QA_MAX_STEPS=16
