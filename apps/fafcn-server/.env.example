# fafcn-server configuration.
# Copy this file to `.env` (same directory) and edit the values.
# `.env` is ignored by git and loaded automatically on startup.
#
# Legend:
#   [REQUIRED]  set it — either the server refuses to start without it,
#               or the deployment is pointless without it
#   [OPTIONAL]  has a built-in default; set only to override

# =============================================================================
# [REQUIRED] LLM provider for the Q&A page — pick ONE of option A or B.
# The server exits at startup if no valid LLM credential is found.
# =============================================================================

# --- Option A: any OpenAI-compatible API (OpenAI, Moonshot, DeepSeek, ...) ---

# [REQUIRED for option A] Your API key.
FAFCN_LLM_API_KEY=sk-your-api-key-here

# [OPTIONAL] Provider type: "openai_compatible" (default) — no need to set for option A.
# FAFCN_LLM_PROVIDER_TYPE=openai_compatible

# [OPTIONAL] Model name (default: gpt-4o).
# Examples: gpt-4o (OpenAI), moonshot-v1-8k (Moonshot CN), kimi-for-coding (Kimi Code)
# FAFCN_LLM_MODEL=gpt-4o

# [OPTIONAL] API base URL (default: https://api.openai.com/v1).
# Examples: https://api.moonshot.cn/v1 (Moonshot CN), https://api.kimi.com/coding/v1 (Kimi Code)
# FAFCN_LLM_BASE_URL=https://api.openai.com/v1

# --- Option B: Kimi Code subscription quota (OAuth token from `kimi login`) ---
# To use this instead of option A, uncomment the two lines below.
# FAFCN_LLM_PROVIDER_TYPE=kimi_code
# [OPTIONAL] defaults to ~/.kimi/credentials/kimi-code.json
# FAFCN_LLM_TOKEN_FILE=/home/YOUR_USERNAME/.kimi/credentials/kimi-code.json

# =============================================================================
# [REQUIRED] Gamedata mirror upload token.
#
# The whole point of this deployment is letting uploaders publish patches,
# so treat this as required: WITHOUT it the mirror is READ-ONLY (players can
# download/sync, but upload endpoints return 503 and nothing can ever be
# published).
# Invent any long random string yourself, e.g.:
#   openssl rand -hex 24
# Then share it privately with the VPN-having uploaders (they paste it into
# the client's 上传 tab once). Never commit the real value to git.
# =============================================================================
FAFCN_GAMEDATA_UPLOAD_TOKEN=

# =============================================================================
# [OPTIONAL] Everything below has working defaults — set only to override.
#
# After starting the server, verify the LLM config with:
#   curl http://localhost:3000/api/health/qa   (expect: pong)
# =============================================================================

# HTTP server port (default: 3000).
# FAFCN_PORT=3000

# Logging (default: info).
# RUST_LOG=info,fafcn_server=debug,agent_core=debug,llm_provider=debug,reqwest=warn,hyper=warn,hyper_util=warn,rustls=warn,extism=warn,wasmtime=warn

# Built Dioxus web assets (default: target/dx/fafcn-web/release/web/public).
# FAFCN_WEB_DIST=target/dx/fafcn-web/release/web/public

# Unit portrait images (default: assets/icons/units).
# FAFCN_PORTRAITS_DIR=assets/icons/units

# Unit database JSON (default: plugins/faf-units/data/faf_units.json, resolved
# at COMPILE time — set this explicitly when the server runs outside the repo).
# FAFCN_UNITS_FILE=plugins/faf-units/data/faf_units.json

# Directory containing `.wasm` plugins for the Q&A agent
# (default: data/qqbot-data/plugins).
# FAFCN_PLUGINS_DIR=data/qqbot-data/plugins

# Q&A system prompt override.
# FAFCN_QA_SYSTEM_PROMPT=You are an expert assistant for the game Forged Alliance Forever.

# Maximum agent reasoning steps per turn (default: 16).
# FAFCN_QA_MAX_STEPS=16

# Gamedata mirror storage root: manifest.json, files/, incoming/
# (default: data/faf-gamedata).
# FAFCN_GAMEDATA_DIR=data/faf-gamedata

# Directory containing downloadable sync client binaries, served at
# /api/gamedata/client/<file> (default: <gamedata dir>/client). Build and
# install the Windows client here with: cargo xtask fafcn file-sync
# FAFCN_GAMEDATA_CLIENT_DIR=data/faf-gamedata/client
